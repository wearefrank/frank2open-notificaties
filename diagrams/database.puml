@startuml
title Database Schema - Notificatie Component

skinparam linetype ortho
skinparam roundcorner 5
skinparam class {
    BackgroundColor White
    BorderColor #444
    HeaderBackgroundColor #1a5276
    HeaderFontColor White
    FontSize 12
}

entity "kanaal" as kanaal {
    * id : BIGSERIAL <<PK>>
    --
    * uuid : VARCHAR(50) <<unique>>
    * naam : VARCHAR(50) <<unique>>
    documentatie_link : VARCHAR(1000)
    * filters : TEXT  (default '[]')
    * created_at : TIMESTAMPTZ
}

entity "abonnement" as abonnement {
    * id : BIGSERIAL <<PK>>
    --
    * uuid : VARCHAR(50) <<unique>>
    * callback_url : VARCHAR(1000)
    * auth : VARCHAR(1000)
    * created_at : TIMESTAMPTZ
}

entity "filter_group" as filter_group {
    * id : BIGSERIAL <<PK>>
    --
    * abonnement_id : BIGINT <<FK>>
    * kanaal_id : BIGINT <<FK>>
    .. unique(abonnement_id, kanaal_id) ..
}

entity "filter" as filter {
    * id : BIGSERIAL <<PK>>
    --
    * filter_group_id : BIGINT <<FK>>
    * filter_key : VARCHAR(100)
    * filter_value : VARCHAR(1000)
    .. unique(filter_group_id, filter_key) ..
}

entity "notificatie" as notificatie {
    * id : BIGSERIAL <<PK>>
    --
    * kanaal_id : BIGINT <<FK>>
    * forwarded_msg : JSON
    * created_at : TIMESTAMPTZ
}

entity "notificatie_response" as notificatie_response {
    * id : BIGSERIAL <<PK>>
    --
    * notificatie_id : BIGINT <<FK>>
    * abonnement_id : BIGINT <<FK>>
    * attempt : SMALLINT (default 1)
    response_status : INTEGER
    * exception : VARCHAR(1000) (default '')
    * created_at : TIMESTAMPTZ
}

entity "jwt_secret" as jwt_secret {
    * id : BIGSERIAL <<PK>>
    --
    * client_id : VARCHAR(255) <<unique>>
    * secret : VARCHAR(512)
    label : VARCHAR(255)
}

note bottom of jwt_secret
  Gebruikt door de Auth-module voor
  HMAC-SHA256 validatie van inkomende JWT's
end note

' Relationships
abonnement ||--o{ filter_group : "subscribes via"
kanaal ||--o{ filter_group : "subscribed to by"
filter_group ||--o{ filter : "has"
kanaal ||--o{ notificatie : "published on"
notificatie ||--o{ notificatie_response : "delivered to"
abonnement ||--o{ notificatie_response : "receives"

@enduml
